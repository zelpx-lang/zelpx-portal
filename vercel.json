{
  "rewrites": [
    {
      "source": "/contractor",
      "destination": "/contractor.html"
    },
    {
      "source": "/customer",
      "destination": "/customer.html"
    },
    {
      "source": "/customer-chat",
      "destination": "/customer-chat.html"
    },
    {
      "source": "/browse-jobs",
      "destination": "/browse-jobs.html"
    }
  ],
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ]
}
